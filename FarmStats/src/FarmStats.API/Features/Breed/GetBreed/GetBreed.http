@host = http://127.0.0.1:5000
@cattleId = 11111111-1111-4111-8111-111111111111
@sheepId = 22222222-2222-4222-8222-222222222222
@missingId = ffffffff-ffff-4fff-8fff-ffffffffffff

### List cattle breeds - expected 200
# Every item must have speciesId equal to cattleId.
# Holstein should appear if the same seed used for Bessie is present.
GET {{host}}/species/{{cattleId}}/breed
Accept: application/json


### List sheep breeds - expected 200 if Sheep exists, otherwise 404
# Existing species with no breed rows returns [].
GET {{host}}/species/{{sheepId}}/breed
Accept: application/json


### Nonexistent species - expected 404, provided missingId is absent
GET {{host}}/species/{{missingId}}/breed
Accept: application/json


### Empty GUID - expected 400 from the validator
GET {{host}}/species/00000000-0000-0000-0000-000000000000/breed
Accept: application/json


### Malformed GUID - expected 400 from request binding
GET {{host}}/species/not-a-guid/breed
Accept: application/json
