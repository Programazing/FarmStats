### Reject moving Bessie's Holstein to Sheep - expected 400
# Requires Bessie to still reference Holstein. Sheep must exist to isolate the in-use check. No change is saved if validation fails.
GET {{host}}/species/{{cattleId}}/breed
Accept: application/json

> {%
const holstein = response.body.find(item => item.id === "33333333-3333-4333-8333-333333333333");
if (holstein) client.global.set("holsteinRevision", holstein.revision);
%}

### Attempt to move Holstein
PUT {{host}}/breed/33333333-3333-4333-8333-333333333333
Content-Type: application/json
Accept: application/json

{
  "revision": "{{holsteinRevision}}",
  "name": "Holstein",
  "speciesId": "22222222-2222-4222-8222-222222222222"
}


> {%
if (response.status === 200) client.global.set("updateBreedRevision", response.body.revision);
%}

### Verify Bessie remains unchanged - expected 200
GET {{host}}/animal/1748e896-2a19-42e9-b6a7-a37d42bdaeb7
Accept: application/json

### Verify final lookup collection - expected 200
GET {{host}}/species/{{cattleId}}/breed
Accept: application/json
