@host = http://127.0.0.1:5000

# Run Features/LookupLifecycle/LookupLifecycle.http first to capture fixture IDs.
# Its final state leaves fixtures deleted. Restore before testing another successful delete.

### GetSpeciesHistory
GET {{host}}/species/{{lookupSpeciesId}}/history
Accept: application/json

### Malformed GUID - expected 400
GET {{host}}/species/not-a-guid/history
Accept: application/json

### Empty GUID - expected 400
GET {{host}}/species/00000000-0000-0000-0000-000000000000/history
Accept: application/json

### Missing target - expected 404 if this ID is absent
GET {{host}}/species/ffffffff-ffff-4fff-8fff-ffffffffffff/history
Accept: application/json

### Invalid pagination - expected 400
GET {{host}}/species/{{lookupSpeciesId}}/history?page=0
Accept: application/json
