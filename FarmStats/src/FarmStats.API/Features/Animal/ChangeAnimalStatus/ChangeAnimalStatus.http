@host = http://127.0.0.1:5000
@cattleId = 11111111-1111-4111-8111-111111111111

# Run AnimalLifecycle.http to create lifecycleAnimalId first.
# These requests modify that disposable fixture, not Bessie.
# Restore requires that the fixture is currently deleted.

### ChangeAnimalStatus
POST {{host}}/animal/{{lifecycleAnimalId}}/status-changes
Content-Type: application/json
Accept: application/json

{
  "revision": "{{lifecycleAnimalRevision}}",
  "status": 1,
  "effectiveDate": "2026-11-18",
  "notes": "Entire record sold."
}


> {%
if (response.status === 200) client.global.set("lifecycleAnimalRevision", response.body.revision);
%}

