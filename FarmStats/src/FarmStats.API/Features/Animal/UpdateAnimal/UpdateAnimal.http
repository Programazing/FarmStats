# Run requests individually. Successful PUT requests modify Bessie.
# The final restore request resets all fields to the values from your successful GET.
# Keep missingId absent from the database for the negative tests.
@host = http://127.0.0.1:5000
@animalId = 1748e896-2a19-42e9-b6a7-a37d42bdaeb7
@cattleId = 11111111-1111-4111-8111-111111111111
@sheepId = 22222222-2222-4222-8222-222222222222
@holsteinId = 33333333-3333-4333-8333-333333333333
@northPastureId = 44444444-4444-4444-8444-444444444444
@missingId = ffffffff-ffff-4fff-8fff-ffffffffffff

### 1. Read Bessie before updating - expected 200
GET {{host}}/animal/{{animalId}}
Accept: application/json


> {%
if (response.status === 200) client.global.set("updateAnimalRevision", response.body.revision);
%}

### 2. Update Bessie - expected 200
PUT {{host}}/animal/{{animalId}}
Content-Type: application/json
Accept: application/json

{
  "revision": "{{updateAnimalRevision}}",
  "name": "Bessie",
  "speciesId": "{{cattleId}}",
  "breedId": "{{holsteinId}}",
  "quantity": 1,
  "referenceId": "C5481-UPDATED",
  "sex": 2,
  "color": "Black and white - updated",
  "birthdate": "2023-04-15",
  "areaId": "{{northPastureId}}"
}


> {%
if (response.status === 200) client.global.set("updateAnimalRevision", response.body.revision);
%}

### 3. Verify saved changes - expected 200 with UPDATED reference ID
GET {{host}}/animal/{{animalId}}
Accept: application/json


> {%
if (response.status === 200) client.global.set("updateAnimalRevision", response.body.revision);
%}

