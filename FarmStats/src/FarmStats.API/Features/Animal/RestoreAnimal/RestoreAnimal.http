@host = http://127.0.0.1:5000
@cattleId = 11111111-1111-4111-8111-111111111111

# Run AnimalLifecycle.http to create lifecycleAnimalId first.
# These requests modify that disposable fixture, not Bessie.
# Restore requires that the fixture is currently deleted.

### RestoreAnimal
POST {{host}}/animal/{{lifecycleAnimalId}}/restore
Content-Type: application/json
Accept: application/json

{
  "notes": "Restore without changing lifecycle status."
}

### Invalid route GUID — expected 400
POST {{host}}/animal/not-a-guid/restore
Content-Type: application/json
Accept: application/json

{
  "notes": "Restore without changing lifecycle status."
}

### Empty route GUID — expected 400
POST {{host}}/animal/00000000-0000-0000-0000-000000000000/restore
Content-Type: application/json
Accept: application/json

{
  "notes": "Restore without changing lifecycle status."
}

### Absent record — expected 404 if this ID is unused
POST {{host}}/animal/ffffffff-ffff-4fff-8fff-ffffffffffff/restore
Content-Type: application/json
Accept: application/json

{
  "notes": "Restore without changing lifecycle status."
}
