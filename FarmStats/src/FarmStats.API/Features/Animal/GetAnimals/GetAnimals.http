@host = http://127.0.0.1:5000

### Get animals using defaults
# Expected: 200 OK.
# Defaults: page 1, page size 25.
GET {{host}}/animals
Accept: application/json


### Get the first page
# Expected: 200 OK with up to 10 animals.
GET {{host}}/animals?page=1&pageSize=10
Accept: application/json


### Get the second page
# Expected: 200 OK.
# Items will be empty if there aren't enough records.
GET {{host}}/animals?page=2&pageSize=10
Accept: application/json


### Get the maximum allowed page size
# Expected: 200 OK with up to 100 animals.
GET {{host}}/animals?page=1&pageSize=100
Accept: application/json


### Invalid page number
# Expected: 400 Bad Request.
GET {{host}}/animals?page=0&pageSize=25
Accept: application/json


### Invalid page size
# Expected: 400 Bad Request.
GET {{host}}/animals?page=1&pageSize=0
Accept: application/json


### Page size exceeds the limit
# Expected: 400 Bad Request.
GET {{host}}/animals?page=1&pageSize=101
Accept: application/json


### Invalid parameter type
# Expected: 400 Bad Request.
GET {{host}}/animals?page=abc&pageSize=25
Accept: application/json