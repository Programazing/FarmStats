%}

### Create a disposable animal using all three lookups - expected 201
POST {{host}}/animal
Content-Type: application/json
Accept: application/json

{
  "name": "Lookup reference safety animal",
  "speciesId": "{{safetySpeciesId}}",
  "breedId": "{{safetyBreedId}}",
  "areaId": "{{safetyAreaId}}",
  "quantity": 1,
  "sex": 0
}

> {%
if (response.status === 201) client.global.set("safetyAnimalRevision", response.body.revision);
client.test("Created animal", function () { client.assert(response.status === 201, "Expected 201"); });
if (response.status === 201) client.global.set("safetyAnimalId", response.body.id);
else client.global.clear("safetyAnimalId");
%}

### Referenced Species cannot be deleted - expected 409
POST {{host}}/species/{{safetySpeciesId}}/deletion
Content-Type: application/json
Accept: application/json

{
  "revision": "{{safetySpeciesRevision}}",
  "reason": 4
}


> {%
if (response.status === 200) client.global.set("safetySpeciesRevision", response.body.revision);
%}

### Referenced Breed cannot be deleted - expected 409
POST {{host}}/breed/{{safetyBreedId}}/deletion
Content-Type: application/json
