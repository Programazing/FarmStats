### Soft-delete only the disposable animal - expected 200
POST {{host}}/animal/{{safetyAnimalId}}/deletion
Content-Type: application/json
Accept: application/json

{
  "revision": "{{safetyAnimalRevision}}",
  "reason": 3,
  "notes": "Reference safety test."
}


> {%
if (response.status === 200) client.global.set("safetyAnimalRevision", response.body.revision);
%}

### Retained deleted-animal reference still blocks Species - expected 409
POST {{host}}/species/{{safetySpeciesId}}/deletion
Content-Type: application/json
Accept: application/json

{
  "revision": "{{safetySpeciesRevision}}",
  "reason": 4
}


> {%
if (response.status === 200) client.global.set("safetySpeciesRevision", response.body.revision);
%}

