@host = http://127.0.0.1:5000

# Run top to bottom. This intentionally leaves retained references.
# It verifies that soft-deleting an animal does NOT permit deleting its lookups.

### Create Species
< {%
request.variables.set("fixtureName", "Reference safety Species " + Date.now() + "-" + Math.random().toString(16).slice(2));
%}
POST {{host}}/species
Content-Type: application/json
Accept: application/json

{
  "name": "{{fixtureName}}"
}

> {%
if (response.status === 201) client.global.set("safetySpeciesRevision", response.body.revision);
client.test("Created", function () { client.assert(response.status === 201, "Expected 201"); });
if (response.status === 201) client.global.set("safetySpeciesId", response.body.id);
else client.global.clear("safetySpeciesId");
%}

### Create Breed
< {%
request.variables.set("fixtureName", "Reference safety Breed " + Date.now() + "-" + Math.random().toString(16).slice(2));
%}
POST {{host}}/breed
Content-Type: application/json
Accept: application/json

{
  "name": "{{fixtureName}}",
  "speciesId": "{{safetySpeciesId}}"
}

> {%
if (response.status === 201) client.global.set("safetyBreedRevision", response.body.revision);
client.test("Created", function () { client.assert(response.status === 201, "Expected 201"); });
if (response.status === 201) client.global.set("safetyBreedId", response.body.id);
else client.global.clear("safetyBreedId");
%}

